# Axeom Studio Operations & Owner OS — Environment Variables
# Copy to .env for local configuration (DO NOT commit real keys to version control)

# Server Port
PORT=5050

# Database Storage Path (defaults to axeom.db in working directory)
AXEOM_DB_PATH=axeom.db

# Flask Environment (development | production)
FLASK_ENV=production

# Typesafe AI (Jev) Credentials
# Create a free account at https://console.typesafe.ai to obtain your key
TYPESAFE_API_KEY=your_typesafe_api_key_here
